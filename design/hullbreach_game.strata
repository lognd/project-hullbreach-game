// Hand-merged from `frob scaffold unity-project .`'s fragments (frob
// T-5198: they don't parse standalone). Rationale: docs/frob.md.
// frob:doc docs/architecture.md#the-one-rule-engine-free-simulation-unity-only-adapters
module hullbreach_game

// Engine-free assemblies: no UnityEngine reference, compiled/tested by
// tools/plaincs with the stock .NET SDK.
// frob:doc docs/architecture.md#the-one-rule-engine-free-simulation-unity-only-adapters
node core : trusted {
    code "Assets/Scripts/Hullbreach.Core/**";
    clearance Internal;
}

// Gravity fields and orbit math; knows about blocks only through Core.
node world : trusted {
    code "Assets/Scripts/Hullbreach.World/**";
    clearance Internal;
}
flow f_world_core : world -> core { label Internal; attr local; attr "Hullbreach.World.asmdef references Hullbreach.Core"; }

// The Q8 FE solver, buckling, damage.
node structure : trusted {
    code "Assets/Scripts/Hullbreach.Structure/**";
    clearance Internal;
}
flow f_structure_core : structure -> core { label Internal; attr local; attr "Hullbreach.Structure.asmdef references Hullbreach.Core"; }

// ShipBody and its authoritative step, shared by client prediction and
// server authority.
node ship : trusted {
    code "Assets/Scripts/Hullbreach.Ship/**";
    clearance Internal;
}
flow f_ship_core : ship -> core { label Internal; attr local; attr "Hullbreach.Ship.asmdef references Hullbreach.Core"; }
flow f_ship_structure : ship -> structure { label Internal; attr local; attr "Hullbreach.Ship.asmdef references Hullbreach.Structure"; }
flow f_ship_world : ship -> world { label Internal; attr local; attr "Hullbreach.Ship.asmdef references Hullbreach.World"; }

// Ship-builder placement/validation logic.
node builder : trusted {
    code "Assets/Scripts/Hullbreach.Builder/**";
    clearance Internal;
}
flow f_builder_core : builder -> core { label Internal; attr local; attr "Hullbreach.Builder.asmdef references Hullbreach.Core"; }

// Engine-free HUD models (D3, ui-port.md#2-decisions).
node hud : trusted {
    code "Assets/Scripts/Hullbreach.Hud/**";
    clearance Internal;
}
flow f_hud_core : hud -> core { label Internal; attr local; attr "Hullbreach.Hud.asmdef references Hullbreach.Core"; }
flow f_hud_builder : hud -> builder { label Internal; attr local; attr "Hullbreach.Hud.asmdef references Hullbreach.Builder"; }

// Authoritative server loop plus the client's non-authoritative twin.
// See docs/frob.md for the planned auth flows below.
node net : trusted {
    code "Assets/Scripts/Hullbreach.Net/**";
    clearance Internal;
    waive "REL200:f_login_game" reason "planned (Jira SCRUM-100, S07-2); no call site exists yet, see docs/frob.md";
    waive "REL200:f_session_check" reason "planned (Jira SCRUM-100, S07-2); no call site exists yet, see docs/frob.md";
    waive "SYS114:f_login_game" reason "call site planned for Jira S07-2; host constraint bound when the client lands" ticket "T-0041";
    waive "SYS114:f_session_check" reason "call site planned for Jira S07-2; host constraint bound when the client lands" ticket "T-0041";
}
flow f_net_core : net -> core { label Internal; attr local; attr "Hullbreach.Net.asmdef references Hullbreach.Core"; }
flow f_net_ship : net -> ship { label Internal; attr local; attr "Hullbreach.Net.asmdef references Hullbreach.Ship"; }
flow f_net_structure : net -> structure { label Internal; attr local; attr "Hullbreach.Net.asmdef references Hullbreach.Structure"; }
flow f_net_world : net -> world { label Internal; attr local; attr "Hullbreach.Net.asmdef references Hullbreach.World"; }

// The one Unity-engine node; the one rule is enforced by ABSENCE of any
// flow targeting `game` above (see docs/frob.md).
// frob:doc docs/architecture.md#the-one-rule-engine-free-simulation-unity-only-adapters
node game : trusted {
    code "Assets/Scripts/Hullbreach.Game/**";
    clearance Internal;
}
flow f_game_core : game -> core { label Internal; attr local; attr "Hullbreach.Game.asmdef references Hullbreach.Core"; }
flow f_game_structure : game -> structure { label Internal; attr local; attr "Hullbreach.Game.asmdef references Hullbreach.Structure"; }
flow f_game_ship : game -> ship { label Internal; attr local; attr "Hullbreach.Game.asmdef references Hullbreach.Ship"; }
flow f_game_builder : game -> builder { label Internal; attr local; attr "Hullbreach.Game.asmdef references Hullbreach.Builder"; }
flow f_game_net : game -> net { label Internal; attr local; attr "Hullbreach.Game.asmdef references Hullbreach.Net"; }
flow f_game_world : game -> world { label Internal; attr local; attr "Hullbreach.Game.asmdef references Hullbreach.World"; }
flow f_game_hud : game -> hud { label Internal; attr local; attr "Hullbreach.Game.asmdef references Hullbreach.Hud"; }

// Editor-only tooling (HudPrefabBuilder, D6 in ui-port.md), never
// shipped in a player build.
node editor : trusted {
    code "Assets/Editor/Hullbreach.Editor/**";
    attr editor;
    clearance Internal;
    may "fs.write" via "Assets/Editor/Hullbreach.Editor/HudPrefabBuilder.cs::Hullbreach.Editor.HudPrefabBuilder.BuildHudCanvasPrefab";
    may "fs.write" via "Assets/Editor/Hullbreach.Editor/HudPrefabBuilder.cs::Hullbreach.Editor.HudPrefabBuilder.BuildChannelBarPrefab";
    // eval: Unity's own -executeMethod, not a call site; see docs/frob.md.
    may "eval";
}

// CWE-78 discharge for editor's may "eval"; rationale in docs/frob.md.
// frob:doc docs/design/frob-and-backlog.md#2-w-frob-in-the-game-repo
assume "weakness:CWE-78:editor" noflow hullbreach_platform_api -> editor owner logan review "2026-10-15"
flow f_editor_core : editor -> core { label Internal; attr local; attr "Hullbreach.Editor.asmdef references Hullbreach.Core"; }
flow f_editor_builder : editor -> builder { label Internal; attr local; attr "Hullbreach.Editor.asmdef references Hullbreach.Builder"; }
flow f_editor_game : editor -> game { label Internal; attr local; attr "Hullbreach.Editor.asmdef references Hullbreach.Game"; }
flow f_editor_hud : editor -> hud { label Internal; attr local; attr "Hullbreach.Editor.asmdef references Hullbreach.Hud"; }

// Test assemblies: one node per *.Tests.asmdef, edges to what that
// asmdef references.
node core_tests : trusted {
    code "Assets/Tests/EditMode/Hullbreach.Core.Tests/**";
    attr editor;
    clearance Internal;
}
flow f_core_tests_core : core_tests -> core { label Internal; attr local; attr "Hullbreach.Core.Tests.asmdef references Hullbreach.Core"; }

node world_tests : trusted {
    code "Assets/Tests/EditMode/Hullbreach.World.Tests/**";
    attr editor;
    clearance Internal;
}
flow f_world_tests_core : world_tests -> core { label Internal; attr local; attr "Hullbreach.World.Tests.asmdef references Hullbreach.Core"; }
flow f_world_tests_ship : world_tests -> ship { label Internal; attr local; attr "Hullbreach.World.Tests.asmdef references Hullbreach.Ship"; }
flow f_world_tests_world : world_tests -> world { label Internal; attr local; attr "Hullbreach.World.Tests.asmdef references Hullbreach.World"; }

node structure_tests : trusted {
    code "Assets/Tests/EditMode/Hullbreach.Structure.Tests/**";
    attr editor;
    clearance Internal;
}
flow f_structure_tests_core : structure_tests -> core { label Internal; attr local; attr "Hullbreach.Structure.Tests.asmdef references Hullbreach.Core"; }
flow f_structure_tests_structure : structure_tests -> structure { label Internal; attr local; attr "Hullbreach.Structure.Tests.asmdef references Hullbreach.Structure"; }

node ship_tests : trusted {
    code "Assets/Tests/EditMode/Hullbreach.Ship.Tests/**";
    attr editor;
    clearance Internal;
}
flow f_ship_tests_core : ship_tests -> core { label Internal; attr local; attr "Hullbreach.Ship.Tests.asmdef references Hullbreach.Core"; }
flow f_ship_tests_ship : ship_tests -> ship { label Internal; attr local; attr "Hullbreach.Ship.Tests.asmdef references Hullbreach.Ship"; }
flow f_ship_tests_world : ship_tests -> world { label Internal; attr local; attr "Hullbreach.Ship.Tests.asmdef references Hullbreach.World"; }

node builder_tests : trusted {
    code "Assets/Tests/EditMode/Hullbreach.Builder.Tests/**";
    attr editor;
    clearance Internal;
}
flow f_builder_tests_core : builder_tests -> core { label Internal; attr local; attr "Hullbreach.Builder.Tests.asmdef references Hullbreach.Core"; }
flow f_builder_tests_builder : builder_tests -> builder { label Internal; attr local; attr "Hullbreach.Builder.Tests.asmdef references Hullbreach.Builder"; }

node hud_tests : trusted {
    code "Assets/Tests/EditMode/Hullbreach.Hud.Tests/**";
    attr editor;
    clearance Internal;
}
flow f_hud_tests_core : hud_tests -> core { label Internal; attr local; attr "Hullbreach.Hud.Tests.asmdef references Hullbreach.Core"; }
flow f_hud_tests_builder : hud_tests -> builder { label Internal; attr local; attr "Hullbreach.Hud.Tests.asmdef references Hullbreach.Builder"; }
flow f_hud_tests_hud : hud_tests -> hud { label Internal; attr local; attr "Hullbreach.Hud.Tests.asmdef references Hullbreach.Hud"; }

node net_tests : trusted {
    code "Assets/Tests/EditMode/Hullbreach.Net.Tests/**";
    attr editor;
    clearance Internal;
}
flow f_net_tests_core : net_tests -> core { label Internal; attr local; attr "Hullbreach.Net.Tests.asmdef references Hullbreach.Core"; }
flow f_net_tests_net : net_tests -> net { label Internal; attr local; attr "Hullbreach.Net.Tests.asmdef references Hullbreach.Net"; }
flow f_net_tests_ship : net_tests -> ship { label Internal; attr local; attr "Hullbreach.Net.Tests.asmdef references Hullbreach.Ship"; }
flow f_net_tests_structure : net_tests -> structure { label Internal; attr local; attr "Hullbreach.Net.Tests.asmdef references Hullbreach.Structure"; }
flow f_net_tests_world : net_tests -> world { label Internal; attr local; attr "Hullbreach.Net.Tests.asmdef references Hullbreach.World"; }

// The one PlayMode suite; unlike other test nodes it flows INTO `game`,
// which is fine (tests may depend on the adapters they exercise).
node demo_tests : trusted {
    code "Assets/Tests/PlayMode/Hullbreach.Demo.Tests/**";
    clearance Internal;
    may "env.read" via "Assets/Tests/PlayMode/Hullbreach.Demo.Tests/DemoScreenshots.cs::Hullbreach.Demo.Tests.DemoScreenshots.CaptureDemoStates";
    may "fs.write" via "Assets/Tests/PlayMode/Hullbreach.Demo.Tests/DemoScreenshots.cs::Hullbreach.Demo.Tests.DemoScreenshots.CaptureDemoStates";
}
flow f_demo_tests_core : demo_tests -> core { label Internal; attr local; attr "Hullbreach.Demo.Tests.asmdef references Hullbreach.Core"; }
flow f_demo_tests_ship : demo_tests -> ship { label Internal; attr local; attr "Hullbreach.Demo.Tests.asmdef references Hullbreach.Ship"; }
flow f_demo_tests_world : demo_tests -> world { label Internal; attr local; attr "Hullbreach.Demo.Tests.asmdef references Hullbreach.World"; }
flow f_demo_tests_structure : demo_tests -> structure { label Internal; attr local; attr "Hullbreach.Demo.Tests.asmdef references Hullbreach.Structure"; }
flow f_demo_tests_builder : demo_tests -> builder { label Internal; attr local; attr "Hullbreach.Demo.Tests.asmdef references Hullbreach.Builder"; }
flow f_demo_tests_net : demo_tests -> net { label Internal; attr local; attr "Hullbreach.Demo.Tests.asmdef references Hullbreach.Net"; }
flow f_demo_tests_game : demo_tests -> game { label Internal; attr local; attr "Hullbreach.Demo.Tests.asmdef references Hullbreach.Game"; }
flow f_demo_tests_hud : demo_tests -> hud { label Internal; attr local; attr "Hullbreach.Demo.Tests.asmdef references Hullbreach.Hud"; }

// The platform's auth API: no code of ours to scan, `managed` like the
// platform side models it. Planned flows/rationale: docs/frob.md.
node hullbreach_platform_api : foreign {
    managed;
}

// Mirrors the platform's f_login_game; sourced from `net`, planned only.
flow f_login_game : net -> hullbreach_platform_api {
    label Pii;
    attr "planned: POST /auth/login (Jira SCRUM-100, S07-2)";
}

// Mirrors the platform's f_session_check; planned alongside f_login_game.
flow f_session_check : net -> hullbreach_platform_api {
    label Internal;
    attr "planned: GET /auth/session (Jira SCRUM-100, S07-2)";
}
