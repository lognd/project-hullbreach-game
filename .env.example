# Hullbreach environment variables (placeholders only; never commit real values).
#
# NOTE: nothing in this repo loads a .env file. The game, play.sh/play.cmd and
# the hbtools doctor read the PROCESS environment only. Copy the values you need
# into your shell yourself, e.g. `export HULLBREACH_PLATFORM_URL=...` (bash),
# `$env:NAME = "..."` (PowerShell) or `set NAME=...` (cmd). Every variable is
# optional; see docs/platform-link.md for defaults and meaning.

# Base URL of the platform API (default http://127.0.0.1:8000).
HULLBREACH_PLATFORM_URL=http://127.0.0.1:8000

# Server only: 1, true or yes makes the server disconnect players without a platform session.
HULLBREACH_REQUIRE_PLATFORM_AUTH=0

# Server only: key sent as X-Server-Key; must match one of the platform's HULLBREACH_GAME_SERVER_API_KEYS.
HULLBREACH_PLATFORM_SERVER_KEY=change-me

# Client: an existing platform session token; signs in without the sign-in screen (demo/testing).
HULLBREACH_PLATFORM_TOKEN=change-me

# Client/tools: platform account name (used with the token or the password below).
HULLBREACH_PLATFORM_USERNAME=your-username

# Tools only (play.sh login, doctor): platform account password; prompted for if unset.
HULLBREACH_PLATFORM_PASSWORD=change-me

# Set to 1 to run the Unity Services online smoke test (play online --headless).
HULLBREACH_ONLINE_SMOKE=

# Directory where the PlayMode demo test writes screenshots (see docs/testing.md).
HULLBREACH_SHOTS=
