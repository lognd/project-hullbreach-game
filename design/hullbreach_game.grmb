/// CWE-78 discharge for the editor's v1 `may "eval"`: no flow enters editor.
claim cwe_78_editor {
  noflow hullbreach_platform_api -> editor;
  proof L1;
  assumed owner=logan review=2027-01-15 because="no inbound flow into editor; the headless -executeMethod entry is Unity's own";
  attr id = "weakness:CWE-78:editor";
}

/// builder stays engine-free: no flow into game.
claim one_rule_builder {
  noflow builder -> game;
  proof L1;
}

// The one rule (docs/architecture.md): engine-free assemblies never
// reference Hullbreach.Game. v1 enforced this by ABSENCE of any flow into
// `game`; grmb states it as a checked claim per engine-free node.
/// core stays engine-free: no flow into game.
claim one_rule_core {
  noflow core -> game;
  proof L1;
}

/// hud stays engine-free: no flow into game.
claim one_rule_hud {
  noflow hud -> game;
  proof L1;
}

/// net stays engine-free: no flow into game.
claim one_rule_net {
  noflow net -> game;
  proof L1;
}

/// ship stays engine-free: no flow into game.
claim one_rule_ship {
  noflow ship -> game;
  proof L1;
}

/// structure stays engine-free: no flow into game.
claim one_rule_structure {
  noflow structure -> game;
  proof L1;
}

/// world stays engine-free: no flow into game.
claim one_rule_world {
  noflow world -> game;
  proof L1;
}
