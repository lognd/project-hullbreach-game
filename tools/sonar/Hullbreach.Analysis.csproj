<!--
  Analysis-only project for SonarQube Cloud automatic analysis.
  Unity generates its own .csproj files locally (gitignored); Sonar's
  automatic .NET analysis needs at least one committed project file to
  pick up the C# sources. Unity ignores this file (it is outside Assets/).
  Do not open or build it from the IDE.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/**/*.cs" />
  </ItemGroup>
</Project>
