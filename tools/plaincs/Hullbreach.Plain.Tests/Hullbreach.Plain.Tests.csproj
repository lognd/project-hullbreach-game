<Project Sdk="Microsoft.NET.Sdk">
  <!-- The edit-mode NUnit tests, run under the stock .NET test host. The
       Unity Test Framework is also NUnit, so the same test sources run in
       both places unchanged. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Hullbreach.Plain/Hullbreach.Plain.csproj" />
  </ItemGroup>
</Project>
