grimble = "2";
// Ported from the v1 strata model (hullbreach_game.strata, itself
// hand-merged from `frob scaffold unity-project .` fragments).
// Rationale and the list of things grmb cannot express: docs/frob.md.
// frob:doc docs/architecture.md#the-one-rule-engine-free-simulation-unity-only-adapters
module hullbreach_game;

/// Ship-builder placement/validation logic.
node builder : trusted {
  clearance Internal;
  owns "Assets/Scripts/Hullbreach.Builder/**";
}

node builder_tests : trusted {
  clearance Internal;
  owns "Assets/Tests/EditMode/Hullbreach.Builder.Tests/**";
  attr editor;
}

// frob:doc docs/architecture.md#the-one-rule-engine-free-simulation-unity-only-adapters
/// Engine-free assemblies: no UnityEngine reference, compiled/tested by
/// tools/plaincs with the stock .NET SDK.
node core : trusted {
  clearance Internal;
  owns "Assets/Scripts/Hullbreach.Core/**";
}

/// Test assemblies: one node per *.Tests.asmdef, edges to what that
/// asmdef references.
node core_tests : trusted {
  clearance Internal;
  owns "Assets/Tests/EditMode/Hullbreach.Core.Tests/**";
  attr editor;
}

// v1 `may "env.read"` (DemoScreenshots reads HULLBREACH_SHOTS) has no grmb
// atom: dropped, see docs/frob.md "Grimble gaps".
/// The one PlayMode suite; unlike other test nodes it flows INTO `game`,
/// which is fine (tests may depend on the adapters they exercise).
node demo_tests : trusted {
  clearance Internal;
  owns "Assets/Tests/PlayMode/Hullbreach.Demo.Tests/**";
  // writes screenshots into that directory.
  may fs.write at "Assets/Tests/PlayMode/Hullbreach.Demo.Tests/DemoScreenshots.cs::Hullbreach.Demo.Tests.DemoScreenshots.CaptureDemoStates";
}

// v1 `may "eval"` (Unity's own -executeMethod, not a call site) has no
// grmb atom: dropped, see docs/frob.md "Grimble gaps".
/// Editor-only tooling (HudPrefabBuilder, D6 in ui-port.md), never
/// shipped in a player build.
node editor : trusted {
  clearance Internal;
  owns "Assets/Editor/Hullbreach.Editor/**";
  // D6 writes the generated channel-bar prefab to disk.
  may fs.write at "Assets/Editor/Hullbreach.Editor/HudPrefabBuilder.cs::Hullbreach.Editor.HudPrefabBuilder.BuildChannelBarPrefab";
  // D6 writes the generated HUD canvas prefab to disk.
  may fs.write at "Assets/Editor/Hullbreach.Editor/HudPrefabBuilder.cs::Hullbreach.Editor.HudPrefabBuilder.BuildHudCanvasPrefab";
  attr editor;
}

// frob:doc docs/architecture.md#the-one-rule-engine-free-simulation-unity-only-adapters
/// The one Unity-engine node; the one rule is enforced by ABSENCE of any
/// flow targeting `game` above (see docs/frob.md).
node game : trusted {
  clearance Internal;
  owns "Assets/Scripts/Hullbreach.Game/**";
}

/// Engine-free HUD models (D3, ui-port.md#2-decisions).
node hud : trusted {
  clearance Internal;
  owns "Assets/Scripts/Hullbreach.Hud/**";
}

node hud_tests : trusted {
  clearance Internal;
  owns "Assets/Tests/EditMode/Hullbreach.Hud.Tests/**";
  attr editor;
}

/// The platform's auth API: no code of ours to scan, `managed` like the
/// platform side models it. Planned flows/rationale: docs/frob.md.
node hullbreach_platform_api : foreign {
  kind external;
  attr managed;
}

/// Authoritative server loop plus the client's non-authoritative twin.
/// See docs/frob.md for the planned auth flows below.
node net : trusted {
  clearance Internal;
  owns "Assets/Scripts/Hullbreach.Net/**";
}

node net_tests : trusted {
  clearance Internal;
  owns "Assets/Tests/EditMode/Hullbreach.Net.Tests/**";
  attr editor;
}

/// ShipBody and its authoritative step, shared by client prediction and
/// server authority.
node ship : trusted {
  clearance Internal;
  owns "Assets/Scripts/Hullbreach.Ship/**";
}

node ship_tests : trusted {
  clearance Internal;
  owns "Assets/Tests/EditMode/Hullbreach.Ship.Tests/**";
  attr editor;
}

/// The Q8 FE solver, buckling, damage.
node structure : trusted {
  clearance Internal;
  owns "Assets/Scripts/Hullbreach.Structure/**";
}

node structure_tests : trusted {
  clearance Internal;
  owns "Assets/Tests/EditMode/Hullbreach.Structure.Tests/**";
  attr editor;
}

/// Gravity fields and orbit math; knows about blocks only through Core.
node world : trusted {
  clearance Internal;
  owns "Assets/Scripts/Hullbreach.World/**";
}

node world_tests : trusted {
  clearance Internal;
  owns "Assets/Tests/EditMode/Hullbreach.World.Tests/**";
  attr editor;
}

/// Hullbreach.Builder.asmdef references Hullbreach.Core.
flow f_builder_core : builder -> core {
  producer "Assets/Scripts/Hullbreach.Builder/Hullbreach.Builder.asmdef";
  consumer "Assets/Scripts/Hullbreach.Core/Hullbreach.Core.asmdef";
  label Internal;
  attr local;
}

